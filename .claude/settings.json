{

  "permissions":{
   "deny": [
      "Bash(git push:*)",
      "Bash(git commit --no-verify:*)"
    ],
    "ask": [
      "Edit(./wiki/SCHEMA.md)",
      "Write(./wiki/SCHEMA.md)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./skills/**)",
      "Write(./skills/**)",
      "Edit(./githooks/**)",
      "Write(./githooks/**)",
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" }
        ]
      }
    ]
  }
}
